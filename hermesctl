ensure_nine_router_api_key() {
  need curl
  need python3
  load_env

  if [[ "${NINEROUTER_AUTO_PROVISION_API_KEY:-true}" != "true" ]]; then
    [[ -n "${NINE_ROUTER_UPSTREAM_API_KEY:-}" ]] \
      || fail "9router automatic API-key provisioning is disabled and NINE_ROUTER_UPSTREAM_API_KEY is empty"
    nine_router_key_valid "${NINE_ROUTER_UPSTREAM_API_KEY}" \
      || fail "configured 9router API key is not accepted"
    echo "[ok] 9router API key is configured"
    return 0
  fi

  # Wait for 9router readiness before validating an existing key. Otherwise a
  # provider that was just restarted can return connection errors and be
  # mistaken for a revoked key, creating duplicate managed credentials.
  if [[ -n "${NINE_ROUTER_UPSTREAM_API_KEY:-}" ]]; then
    if ! wait_nine_router 75; then
      fail "9router did not become ready; refusing to rotate the existing managed API key"
    fi
    local existing_status
    existing_status="$(nine_router_key_http_status "${NINE_ROUTER_UPSTREAM_API_KEY}")"
    if [[ "$existing_status" == "200" ]]; then
      echo "[ok] managed 9router API key is already valid"
      return 0
    fi
    if [[ "$existing_status" != "401" && "$existing_status" != "403" ]]; then
      fail "9router key validation returned HTTP ${existing_status}; refusing credential rotation on a transient/non-authentication error"
    fi
    info "existing 9router managed key was explicitly rejected (${existing_status}); rotating it"
  else
    if ! wait_nine_router 75; then
      fail "9router did not become reachable for API-key provisioning"
    fi
  fi

  info "provisioning dedicated 9router API key for Router Gateway"

  [[ -n "${NINEROUTER_INITIAL_PASSWORD:-}" ]] \
    || fail "NINEROUTER_INITIAL_PASSWORD is missing; cannot authenticate to 9router management API"

  local tmpdir cookie login_json key_json login_code key_code managed_name provisioned_key base
  tmpdir="$(mktemp -d)"
  chmod 700 "$tmpdir"
  cookie="$tmpdir/cookies"
  login_json="$tmpdir/login.json"
  key_json="$tmpdir/key.json"
  managed_name="${NINEROUTER_MANAGED_API_KEY_NAME:-hermes-control-plane-router-gateway}"
  base="$(nine_router_host_url)"

  login_code="$(
    python3 - "${NINEROUTER_INITIAL_PASSWORD}" <<'PYLOGIN' |
import json, sys
print(json.dumps({"password": sys.argv[1]}))
PYLOGIN
    curl -sS \
      -c "$cookie" \
      -o "$login_json" \
      -w '%{http_code}' \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${base}/api/auth/login" || true
  )"

  if [[ "$login_code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "9router management login failed with HTTP ${login_code:-unreachable}; provisioning stops after one attempt to avoid dashboard lockout"
  fi

  key_code="$(
    python3 - "$managed_name" <<'PYKEY' |
import json, sys
print(json.dumps({"name": sys.argv[1]}))
PYKEY
    curl -sS \
      -b "$cookie" \
      -o "$key_json" \
      -w '%{http_code}' \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${base}/api/keys" || true
  )"

  if [[ "$key_code" != "201" ]]; then
    rm -rf "$tmpdir"
    fail "9router API-key creation failed with HTTP ${key_code:-unreachable}"
  fi

  provisioned_key="$(
    python3 - "$key_json" <<'PYREAD'
import json, sys
data=json.load(open(sys.argv[1]))
key=data.get("key")
if not isinstance(key, str) or len(key.strip()) < 16 or any(ch.isspace() for ch in key):
    raise SystemExit(2)
print(key.strip())
PYREAD
  )" || {
    rm -rf "$tmpdir"
    fail "9router API-key creation returned an invalid response"
  }

  rm -rf "$tmpdir"

  set_env NINE_ROUTER_UPSTREAM_API_KEY "$provisioned_key"
  chmod 600 "$ENV_FILE"
  load_env

  if ! nine_router_key_valid "${NINE_ROUTER_UPSTREAM_API_KEY}"; then
    fail "9router created a managed key but rejected it during verification"
  fi

  echo "[ok] provisioned and verified dedicated 9router Router Gateway API key"
  echo "     key material stored only in local .env"
}

ensure_nine_router_routing_combos() {
  need curl
  need python3
  load_env

  if [[ "${NINEROUTER_AUTO_PROVISION_COMBOS:-true}" != "true" ]]; then
    echo "[ok] automatic 9router Hermes combo provisioning is disabled"
    return 0
  fi

  [[ -n "${NINEROUTER_INITIAL_PASSWORD:-}" ]] \
    || fail "NINEROUTER_INITIAL_PASSWORD is missing; cannot reconcile 9router routing combos"
  [[ -n "${NINE_ROUTER_UPSTREAM_API_KEY:-}" ]] \
    || fail "NINE_ROUTER_UPSTREAM_API_KEY is missing; cannot verify 9router routing combos"
  wait_nine_router 75 || fail "9router did not become ready for routing-combo reconciliation"

  local tmpdir cookie login_json combos_json catalog_json plan_dir code base
  tmpdir="$(mktemp -d)"
  chmod 700 "$tmpdir"
  cookie="$tmpdir/cookies"
  login_json="$tmpdir/login.json"
  combos_json="$tmpdir/combos.json"
  catalog_json="$tmpdir/opencode-models.json"
  plan_dir="$tmpdir/plan"
  mkdir -p "$plan_dir"
  base="$(nine_router_host_url)"

  code="$(
    python3 - "${NINEROUTER_INITIAL_PASSWORD}" <<'PYLOGIN' |
import json, sys
print(json.dumps({"password": sys.argv[1]}))
PYLOGIN
    curl -sS -c "$cookie" -o "$login_json" -w '%{http_code}' \
      -H 'Content-Type: application/json' --data-binary @- \
      "${base}/api/auth/login" || true
  )"
  if [[ "$code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "9router management login failed; routing-combo reconciliation aborted"
  fi

  code="$(curl -sS -b "$cookie" -o "$combos_json" -w '%{http_code}' \
    "${base}/api/combos" || true)"
  if [[ "$code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "9router combo listing failed with HTTP ${code:-unreachable}"
  fi

  # A temporary OpenCode catalog outage must not make an already-provisioned
  # router unbootable. We only require the live catalog when one of the
  # Hermes-required combos is missing; otherwise we preserve the existing
  # routing objects and let `router probe` validate a real completion.
  local missing_before
  missing_before="$(python3 - "$combos_json" <<'PYCHECK'
import json, sys
doc=json.load(open(sys.argv[1], encoding='utf-8'))
combos=doc.get('combos', []) if isinstance(doc, dict) else []
names={c.get('name') for c in combos if isinstance(c, dict)}
required=['ai','combo-fast','combo-standard','combo-strong']
print(','.join(x for x in required if x not in names))
PYCHECK
)"

  local catalog_url catalog_ok=true
  catalog_url="${NINEROUTER_OPENCODE_CATALOG_URL:-https://opencode.ai/zen/v1/models}"
  code="$(curl -sS --compressed --connect-timeout 5 --max-time 25 -o "$catalog_json" -w '%{http_code}' \
    -H 'x-opencode-client: desktop' "$catalog_url" || true)"
  if [[ "$code" != "200" ]]; then
    catalog_ok=false
  fi

  if [[ "$catalog_ok" == "false" ]]; then
    if [[ -n "$missing_before" ]]; then
      rm -rf "$tmpdir"
      fail "OpenCode free-model catalog returned HTTP ${code:-unreachable} and required 9router combo(s) are missing: ${missing_before}"
    fi
    echo "[warn] OpenCode free-model catalog unavailable (HTTP ${code:-unreachable}); preserving existing 9router Hermes combos"
  else
    if ! python3 - "$combos_json" "$catalog_json" "$plan_dir" <<'PYCOMBO'; then
import json, pathlib, sys
combos_path, catalog_path, out_dir = sys.argv[1:4]
out = pathlib.Path(out_dir)
combos_doc = json.load(open(combos_path, encoding='utf-8'))
catalog = json.load(open(catalog_path, encoding='utf-8'))
combos = combos_doc.get('combos', []) if isinstance(combos_doc, dict) else []
if not isinstance(combos, list):
    raise SystemExit('invalid 9router combo response')
models = catalog.get('data', []) if isinstance(catalog, dict) else []
free = []
for item in models:
    if not isinstance(item, dict):
        continue
    mid = item.get('id')
    if isinstance(mid, str) and (mid.endswith('-free') or mid == 'big-pickle'):
        free.append('oc/' + mid)
free = list(dict.fromkeys(free))
if not free:
    raise SystemExit('OpenCode returned no currently free models')
existing = {c.get('name'): c for c in combos if isinstance(c, dict) and isinstance(c.get('name'), str)}
required = ['ai', 'combo-fast', 'combo-standard', 'combo-strong']
for name in required:
    payload = {'name': name, 'models': free, 'kind': 'llm'}
    (out / f'{name}.json').write_text(json.dumps(payload), encoding='utf-8')
    current = existing.get(name)
    if name == 'ai' and current:
        cid = current.get('id')
        if not cid:
            raise SystemExit('existing ai combo has no id')
        action = f'update|{cid}'
    elif current:
        # Seed tier combos once, then let the operator own/customize them.
        action = 'preserve|'
    else:
        action = 'create|'
    (out / f'{name}.action').write_text(action + '\n', encoding='utf-8')
(out / 'count').write_text(str(len(free)) + '\n', encoding='utf-8')
PYCOMBO
      rm -rf "$tmpdir"
      if [[ -z "$missing_before" ]]; then
        echo "[warn] OpenCode free-model catalog contained no usable free models; preserving existing 9router Hermes combos"
        return 0
      fi
      fail "could not build the 9router routing-combo reconciliation plan"
    fi

    local name action id payload result_code
    for name in ai combo-fast combo-standard combo-strong; do
      # action files are deliberately tiny and may not end with a newline.
      # `read` returns status 1 at EOF without a trailing newline, which under
      # `set -e` used to abort `hermesctl up` silently before creating combos.
      # Accept EOF after populated fields, then validate the parsed action below.
      action=""
      id=""
      IFS='|' read -r action id <"$plan_dir/${name}.action" || true
      payload="$plan_dir/${name}.json"
      case "$action" in
        preserve)
          echo "[ok] 9router combo ${name} exists; preserving operator configuration"
          ;;
        create)
          result_code="$(curl -sS -b "$cookie" -o "$tmpdir/${name}.result" -w '%{http_code}' \
            -H 'Content-Type: application/json' --data-binary @"$payload" \
            "${base}/api/combos" || true)"
          if [[ "$result_code" != "201" ]]; then
            rm -rf "$tmpdir"
            fail "9router combo ${name} creation failed with HTTP ${result_code:-unreachable}"
          fi
          echo "[ok] created 9router combo ${name}"
          ;;
        update)
          result_code="$(curl -sS -b "$cookie" -o "$tmpdir/${name}.result" -w '%{http_code}' \
            -X PUT -H 'Content-Type: application/json' --data-binary @"$payload" \
            "${base}/api/combos/${id}" || true)"
          if [[ "$result_code" != "200" ]]; then
            rm -rf "$tmpdir"
            fail "9router combo ${name} update failed with HTTP ${result_code:-unreachable}"
          fi
          echo "[ok] refreshed 9router managed combo ${name}"
          ;;
        *)
          rm -rf "$tmpdir"
          fail "invalid 9router combo reconciliation action for ${name}"
          ;;
      esac
    done
  fi

  local models_json
  models_json="$tmpdir/models.json"
  code="$(curl -sS --compressed -o "$models_json" -w '%{http_code}' \
    -H "Authorization: Bearer ${NINE_ROUTER_UPSTREAM_API_KEY}" \
    "${base}/v1/models" || true)"
  if [[ "$code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "9router rejected its managed key while verifying routing combos"
  fi
  if ! python3 - "$models_json" <<'PYVERIFY'; then
import json, sys
data = json.load(open(sys.argv[1], encoding='utf-8'))
items = data.get('data', []) if isinstance(data, dict) else []
ids = {x.get('id') for x in items if isinstance(x, dict)}
required = {'ai', 'combo-fast', 'combo-standard', 'combo-strong'}
missing = sorted(required - ids)
if missing:
    print('missing required combo(s): ' + ', '.join(missing), file=sys.stderr)
    raise SystemExit(1)
PYVERIFY
    rm -rf "$tmpdir"
    fail "9router routing-combo verification failed"
  fi

  if [[ "$catalog_ok" == "true" ]]; then
    local free_count
    free_count="$(cat "$plan_dir/count")"
    echo "[ok] 9router Hermes routing combos ready (${free_count} current OpenCode free model(s))"
  else
    echo "[ok] existing 9router Hermes routing combos verified"
  fi
  rm -rf "$tmpdir"
}

