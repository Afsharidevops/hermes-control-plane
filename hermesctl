cmd_backup() {
  need docker; need python3
  load_env
  mkdir -p "$ROOT/backups"
  local stamp remote out
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  remote="/data/hermes-control-plane-backup-${stamp}.sqlite3"
  out="$ROOT/backups/control-plane-${stamp}.sqlite3"
  "${COMPOSE[@]}" ps --status running --services | grep -qx control-plane \
    || fail "control-plane must be running for an online backup"
  "${COMPOSE[@]}" exec -T control-plane python - "$remote" <<'PYBACKUP'
import sqlite3, sys
src=sqlite3.connect('/data/control-plane.sqlite3')
dst=sqlite3.connect(sys.argv[1])
try:
    src.backup(dst)
    dst.commit()
finally:
    dst.close(); src.close()
check=sqlite3.connect(sys.argv[1]).execute('PRAGMA quick_check').fetchone()[0]
if check != 'ok':
    raise SystemExit(f'backup integrity failed: {check}')
PYBACKUP
  "${COMPOSE[@]}" cp "control-plane:${remote}" "$out" >/dev/null
  "${COMPOSE[@]}" exec -T control-plane python -c "import os; os.unlink('${remote}')" >/dev/null 2>&1 || true
  python3 "$ROOT/scripts/control-plane-db.py" check "$out" >/dev/null
  echo "Backup: $out"
}

cmd_restore() {
  need docker; need python3
  local source="${1:-}"
  [[ -f "$source" ]] || fail "usage: ./hermesctl restore <backup.sqlite3>"
  source="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$source")"
  python3 "$ROOT/scripts/control-plane-db.py" check "$source" >/dev/null
  load_env
  info "creating pre-restore backup"
  cmd_backup
  local remote="/data/hermes-control-plane-restore.sqlite3"
  "${COMPOSE[@]}" cp "$source" "control-plane:${remote}" >/dev/null
  "${COMPOSE[@]}" stop control-plane >/dev/null
  if ! "${COMPOSE[@]}" run --rm --no-deps --entrypoint python control-plane - <<'PYRESTORE'
import os, sqlite3
src_path='/data/hermes-control-plane-restore.sqlite3'
dst_path='/data/control-plane.sqlite3'
tmp_path='/data/control-plane.restore.tmp'
src=sqlite3.connect(f'file:{src_path}?mode=ro', uri=True)
dst=sqlite3.connect(tmp_path)
try:
    if src.execute('PRAGMA quick_check').fetchone()[0] != 'ok':
        raise SystemExit('restore source integrity check failed')
    src.backup(dst); dst.commit()
finally:
    dst.close(); src.close()
check=sqlite3.connect(tmp_path).execute('PRAGMA quick_check').fetchone()[0]
if check != 'ok':
    raise SystemExit(f'restored database integrity failed: {check}')
os.replace(tmp_path, dst_path)
os.unlink(src_path)
PYRESTORE
  then
    "${COMPOSE[@]}" up -d control-plane >/dev/null || true
    fail "restore failed; existing database was preserved and a pre-restore backup was created"
  fi
  "${COMPOSE[@]}" up -d control-plane >/dev/null
  cmd_wait 90
  echo "[ok] restored Control Plane database from $source"
}

cmd_upgrade() {
  need docker
  local target="${1:-}"
  [[ -n "$target" ]] || fail "usage: ./hermesctl upgrade <version>"
  [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]] || fail "invalid version: $target"
  load_env
  local old="${VERSION:-}"
  local ns="${IMAGE_NAMESPACE:-afsharidevops}"
  info "verifying published release images for $target"
  docker buildx imagetools inspect "$ns/hermes-control-plane-api:$target" >/dev/null || fail "API image tag not found"
  docker buildx imagetools inspect "$ns/hermes-control-plane-kubernetes-broker:$target" >/dev/null || fail "Kubernetes Broker image tag not found"
  if "${COMPOSE[@]}" ps --status running --services | grep -qx control-plane; then
    cmd_backup
  fi
  set_env VERSION "$target"
  if ! cmd_up --pull; then
    echo "Upgrade failed; restoring configured version $old" >&2
    set_env VERSION "$old"
    cmd_up --pull || true
    return 1
  fi
  info "upgrade complete: $old -> $target"
}

cmd_kubeconfig_import() {
  need curl; need python3; need sha256sum
  local name="${1:-}" file="${2:-}"
  [[ -n "$name" && -f "$file" ]] || fail "usage: ./hermesctl kubeconfig import <name> <file>"
  load_env
  local sha response id dest
  sha="$(sha256sum "$file" | awk '{print $1}')"
  response="$(python3 - "$name" "$sha" <<'PYJSON' | curl -fsS -X POST \
      -H "Authorization: Bearer ${HERMES_CONTROL_ADMIN_TOKEN}" -H 'Content-Type: application/json' \
      --data-binary @- "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs"
import json,sys
print(json.dumps({"name":sys.argv[1],"kind":"kubeconfig","provider":"local-file","metadata":{"storage":"local-kubeconfig","sha256":sys.argv[2]}}))
PYJSON
  )"
  id="$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
  dest="$ROOT/data/kubeconfigs/${id}.yaml"
  install -m 0600 "$file" "$dest"
  python3 - "$sha" "$id" <<'PYJSON' | curl -fsS -X PATCH \
      -H "Authorization: Bearer ${HERMES_CONTROL_ADMIN_TOKEN}" -H 'Content-Type: application/json' \
      --data-binary @- "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs/$id" | python3 -m json.tool
import json,sys
print(json.dumps({"metadata":{"storage":"local-kubeconfig","sha256":sys.argv[1],"file":sys.argv[2]+".yaml"}}))
PYJSON
  echo "Stored kubeconfig material at $dest (mode 0600). The Control Plane stores only its reference/fingerprint."
}

cmd_kubeconfig_list() {
  need curl; need python3
  load_env
  curl -fsS "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs" | python3 -c 'import json,sys; print(json.dumps([x for x in json.load(sys.stdin) if x.get("kind")=="kubeconfig"], indent=2))'
}

cmd_kubeconfig_remove() {
  need curl
  local id="${1:-}"
  [[ "$id" =~ ^cred_[0-9a-f]{16}$ ]] || fail "usage: ./hermesctl kubeconfig remove <credential-id>"
  load_env
  curl -fsS -X DELETE -H "Authorization: Bearer ${HERMES_CONTROL_ADMIN_TOKEN}" "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs/$id"
  rm -f "$ROOT/data/kubeconfigs/$id.yaml"
  echo "Removed $id"
}

cmd_execution() {
  need docker
  local action="${1:-status}"
  load_env
  case "$action" in
    status)
      echo "HERMES_EXECUTION_ENABLED=${HERMES_EXECUTION_ENABLED:-false}"
      echo "HERMES_KUBERNETES_EXECUTION_ENABLED=${HERMES_KUBERNETES_EXECUTION_ENABLED:-false}"
      ;;
    enable|disable)
      local value=false
      [[ "$action" == "enable" ]] && value=true
      set_env HERMES_EXECUTION_ENABLED "$value"
      set_env HERMES_KUBERNETES_EXECUTION_ENABLED "$value"
      load_env
      info "execution ${action}d; recreating Control Plane and Kubernetes Broker"
      "${COMPOSE[@]}" up -d --force-recreate control-plane kubernetes-broker
      cmd_wait 90
      cmd_execution status
      ;;
    *) fail "usage: ./hermesctl execution enable|disable|status" ;;
  esac
}

cmd_bot() {
  need python3
  local action="${1:-status}" value="${2:-}"
  load_env
  case "$action" in
    status)
      [[ -n "${HERMES_BOT_SERVICE_TOKEN:-}" && "${HERMES_BOT_SERVICE_TOKEN:-}" != "CHANGE_ME" ]] && echo "Hermes Bot service identity: configured" || echo "Hermes Bot service identity: missing"
      [[ -n "${HERMES_APPROVAL_BOT_TOKEN:-}" && "${HERMES_APPROVAL_BOT_TOKEN:-}" != "CHANGE_ME" ]] && echo "Approval Bot service identity: configured" || echo "Approval Bot service identity: missing"
      [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]] && echo "Hermes Telegram gateway token: configured" || echo "Hermes Telegram gateway token: missing"
      echo "Telegram gateway users: ${TELEGRAM_ALLOWED_USERS:-<none>}"
      echo "Telegram mutation users: ${HERMES_CONTROL_PLANE_BOT_USERS:-<none>}"
      ;;
    allow)
      [[ "$value" =~ ^[0-9]+$ ]] || fail "usage: ./hermesctl bot allow <numeric-telegram-user-id>"
      local mutation_users telegram_users
      mutation_users="$(python3 - "${HERMES_CONTROL_PLANE_BOT_USERS:-}" "$value" <<'PYBOT'
import sys
existing=[x.strip() for x in sys.argv[1].replace(',', '\n').splitlines() if x.strip().isdigit()]
value=sys.argv[2]
if value not in existing:
    existing.append(value)
print(','.join(existing))
PYBOT
)"
      telegram_users="$(python3 - "${TELEGRAM_ALLOWED_USERS:-}" "$mutation_users" <<'PYBOT'
import sys
out=[]
for raw in sys.argv[1:]:
    for item in raw.replace(',', '\n').splitlines():
        item=item.strip()
        if item.isdigit() and item not in out:
            out.append(item)
print(','.join(out))
PYBOT
)"
      set_env HERMES_CONTROL_PLANE_BOT_USERS "$mutation_users"
      set_env TELEGRAM_ALLOWED_USERS "$telegram_users"
      echo "Allowed Telegram user $value for Hermes Control Plane mutation requests."
      echo "The user is also allowed through the Hermes Telegram gateway."
      ;;
    telegram)
      local token
      printf 'Telegram bot token (input hidden): ' >&2
      IFS= read -r -s token
      printf '\n' >&2
      [[ "$token" =~ ^[0-9]+:[A-Za-z0-9_-]{20,}$ ]] || fail "Telegram bot token format does not look valid"
      set_env TELEGRAM_BOT_TOKEN "$token"
      load_env
      echo "Hermes Telegram gateway token saved to local .env."
      if command -v docker >/dev/null 2>&1; then
        ensure_hermes_router_model
        ensure_chatops_plugin
        if "${COMPOSE[@]}" --profile hermes ps --status running --services 2>/dev/null | grep -qx hermes; then
          info "recreating Hermes so Telegram/plugin configuration is loaded"
          "${COMPOSE[@]}" --profile hermes up -d --force-recreate hermes
        fi
      fi
      ;;
    model-sync)
      ensure_hermes_router_model
      if "${COMPOSE[@]}" --profile hermes ps --status running --services 2>/dev/null | grep -qx hermes; then
        info "recreating Hermes with synchronized Smart Router model configuration"
        "${COMPOSE[@]}" --profile hermes up -d --force-recreate hermes
      fi
      ;;
    check)
      need docker
      echo "Local bot configuration:"
      cmd_bot status
      echo
      echo "Runtime ChatOps plugin:"
      if ! "${COMPOSE[@]}" --profile hermes ps --status running --services | grep -qx hermes; then
        echo "[warn] Hermes container is not running"
        return 0
      fi
      if "${COMPOSE[@]}" --profile hermes exec -T hermes sh -lc \
          'test -f /opt/data/plugins/control-plane-chatops/plugin.yaml'; then
        echo "[ok] plugin mounted at /opt/data/plugins/control-plane-chatops"
      else
        echo "[fail] control-plane-chatops plugin mount missing"
        return 1
      fi
      local plugin_line
      plugin_line="$(hermes_cli_run plugins list --plain --no-bundled 2>&1 | grep -i "control-plane-chatops" | head -1 || true)"
      if [[ -n "$plugin_line" ]]; then
        echo "[ok] plugin discovered: control-plane-chatops"
      else
        echo "[fail] plugin is mounted but Hermes does not discover it"
        return 1
      fi
      local model_summary
      model_summary="$("${COMPOSE[@]}" --profile hermes exec -T hermes /opt/hermes/.venv/bin/python - <<'PYMODELCHK'
from pathlib import Path
import yaml
data=yaml.safe_load(Path('/opt/data/config.yaml').read_text()) or {}
m=data.get('model') if isinstance(data,dict) else {}
print(f"{m.get('provider','')}|{m.get('default','')}|{m.get('base_url','')}|{m.get('api_mode','')}|{m.get('api_key','')}" if isinstance(m,dict) else 'invalid')
PYMODELCHK
)"
      if [[ "$model_summary" == 'custom|auto|http://smart-router:8080/v1|chat_completions|${OPENAI_API_KEY}' ]]; then
        echo "[ok] Hermes main model routed through Smart Router with environment-key reference"
      else
        echo "[warn] Hermes model configuration not synchronized; fixing it"
        ensure_hermes_router_model
        info "recreating Hermes so the repaired model configuration is active"
        "${COMPOSE[@]}" --profile hermes up -d --force-recreate hermes
        sleep 5
      fi
      if "${COMPOSE[@]}" --profile hermes exec -T hermes /opt/hermes/.venv/bin/python - <<'PYAUTHCHK'
import os, urllib.error, urllib.request
key=os.environ.get('OPENAI_API_KEY','')
if not key:
    print('[fail] OPENAI_API_KEY missing inside Hermes')
    raise SystemExit(1)
req=urllib.request.Request('http://smart-router:8080/v1/models', headers={'Authorization': f'Bearer {key}'})
try:
    with urllib.request.urlopen(req, timeout=10) as response:
        if response.status != 200:
            print(f'[fail] Hermes -> Smart Router authentication HTTP {response.status}')
            raise SystemExit(1)
except urllib.error.HTTPError as exc:
    print(f'[fail] Hermes -> Smart Router authentication HTTP {exc.code}')
    raise SystemExit(1)
print('[ok] Hermes -> Smart Router authenticated runtime request')
PYAUTHCHK
      then
        :
      else
        return 1
      fi
      if grep -qE '^[[:space:]]*-[[:space:]]*control-plane-chatops[[:space:]]*$' <(
          "${COMPOSE[@]}" --profile hermes exec -T hermes sh -lc \
            "sed -n '/^plugins:/,/^[^[:space:]]/p' /opt/data/config.yaml 2>/dev/null" || true
        ); then
        echo "[ok] plugin is present in plugins.enabled"
      else
        echo "[warn] could not prove plugin enabled from config.yaml; re-running enable"
        ensure_chatops_plugin
      fi
      ;;
    *) fail "usage: ./hermesctl bot allow <telegram-user-id>|telegram|model-sync|status|check" ;;
  esac
}

cmd_doctor() {
  need python3
  echo "Hermes Control Plane doctor"
  echo "Version: $(cat "$ROOT/VERSION")"
  local file_version file_ns
  file_version="$(grep '^VERSION=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  file_ns="$(grep '^IMAGE_NAMESPACE=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  if [[ -n "$SHELL_VERSION_OVERRIDE" && "$SHELL_VERSION_OVERRIDE" != "$file_version" ]]; then echo "[warn] shell VERSION=$SHELL_VERSION_OVERRIDE differs from .env VERSION=$file_version"; fi
  if [[ -n "$SHELL_NAMESPACE_OVERRIDE" && "$SHELL_NAMESPACE_OVERRIDE" != "$file_ns" ]]; then echo "[warn] shell IMAGE_NAMESPACE=$SHELL_NAMESPACE_OVERRIDE differs from .env IMAGE_NAMESPACE=$file_ns"; fi
  for c in docker curl openssl python3; do
    if command -v "$c" >/dev/null 2>&1; then echo "[ok] $c"; else echo "[missing] $c"; fi
  done
  if command -v docker >/dev/null 2>&1 && [[ -f "$ENV_FILE" ]]; then
    if "${COMPOSE[@]}" config >/dev/null; then echo "[ok] docker compose config"; else echo "[fail] docker compose config"; fi
    load_env
    local host_uid host_gid broker_uid broker_gid
    host_uid="$(id -u)"; host_gid="$(id -g)"
    broker_uid="${HERMES_KUBERNETES_BROKER_UID:-}"
    broker_gid="${HERMES_KUBERNETES_BROKER_GID:-}"
    if [[ "$broker_uid" == "$host_uid" && "$broker_gid" == "$host_gid" ]]; then
      echo "[ok] Kubernetes Broker UID/GID matches local kubeconfig owner (${host_uid}:${host_gid})"
    else
      echo "[warn] Kubernetes Broker UID/GID=${broker_uid:-unset}:${broker_gid:-unset}; local operator=${host_uid}:${host_gid}; run ./hermesctl init"
    fi
    if [[ -n "${TELEGRAM_BOT_TOKEN:-}" ]]; then
      echo "[ok] Hermes Telegram gateway token configured"
    else
      echo "[warn] Hermes Telegram gateway token missing; run ./hermesctl bot telegram"
    fi
    if [[ -n "${HERMES_CONTROL_PLANE_BOT_USERS:-}" && -n "${TELEGRAM_ALLOWED_USERS:-}" ]]; then
      echo "[ok] Telegram/Control Plane bot allowlists configured"
    else
      echo "[warn] Telegram bot allowlist incomplete; run ./hermesctl bot allow <numeric-id>"
    fi
    if [[ -n "${SMART_ROUTER_CLIENT_API_KEY:-}" ]]; then
      echo "[ok] Smart Router stack client credential configured"
    else
      echo "[fail] SMART_ROUTER_CLIENT_API_KEY missing"
    fi
    if [[ "${NINEROUTER_AUTO_PROVISION_API_KEY:-true}" == "true" ]]; then
      echo "[ok] 9router API-key auto-provisioning enabled"
    else
      echo "[warn] 9router API-key auto-provisioning disabled"
    fi
    if [[ -n "${NINE_ROUTER_UPSTREAM_API_KEY:-}" ]]; then
      echo "[ok] managed 9router Router Gateway credential present"
    else
      echo "[info] managed 9router credential will be created automatically when 9router is enabled"
    fi
    if [[ "${OMNIROUTE_AUTO_PROVISION_API_KEY:-true}" == "true" ]]; then
      echo "[ok] OmniRoute API-key auto-provisioning enabled"
    else
      echo "[warn] OmniRoute API-key auto-provisioning disabled"
    fi
    if [[ -n "${OMNIROUTE_UPSTREAM_API_KEY:-}" ]]; then
      echo "[ok] managed OmniRoute Router Gateway credential present"
    else
      echo "[info] managed OmniRoute credential will be created automatically when OmniRoute is enabled"
    fi
  fi
}

usage() {
  cat <<'TXT'
Usage: ./hermesctl <command>

Commands:
  init                         Create .env and generate missing local secrets
  up                           Build/start core + Hermes + selected router
  up --pull                    Pull published images and start without local builds
  down                         Stop the stack
  status                       Show Compose and service health
  wait [seconds]               Wait until Control Plane and Kubernetes Broker are ready
  execution enable|disable     Toggle mutation execution and wait for readiness
  execution status             Show execution gates
  bot allow <telegram-id>      Allow a numeric Telegram user to request bot-only mutations
  bot telegram                 Configure Telegram bot token with hidden input
  bot model-sync               Route Hermes main model through internal Smart Router
  bot status                   Show bot/gateway configuration status (never tokens)
  bot check                    Check ChatOps plugin + Smart Router model wiring
  doctor                       Check local prerequisites/config
  router list                  Show configured router health and active provider
  router provision <provider>  Provision/repair router key and 9router routing combos
  router cleanup-keys [scope]  Remove stale managed keys (nine-router|omniroute|all)
  router probe                 Verify auth plus a real end-to-end chat completion
  router set nine-router       Start/select 9router
  router set omniroute         Start/select OmniRoute
  version                      Show repository/configured/running versions
  version set <version>        Set .env VERSION explicitly
  upgrade <version>            Verify, backup, pull and upgrade a published release
  backup                       Create and integrity-check an online Control Plane backup
  restore <backup.sqlite3>     Restore a verified backup with a pre-restore safety backup
  kubeconfig import <n> <file> Import kubeconfig material locally and create a reference
  kubeconfig list              List kubeconfig credential references
  kubeconfig remove <id>       Remove unused kubeconfig reference and local material
TXT
}

case "${1:-}" in
  init) init_env ;;
  up) cmd_up "${2:-}" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  wait) cmd_wait "${2:-60}" ;;
  execution) cmd_execution "${2:-status}" ;;
  bot) cmd_bot "${2:-status}" "${3:-}" ;;
  doctor) cmd_doctor ;;
  version) cmd_version "${2:-show}" "${3:-}" ;;
  upgrade) cmd_upgrade "${2:-}" ;;
  backup) cmd_backup ;;
  restore) cmd_restore "${2:-}" ;;
  kubeconfig)
    case "${2:-}" in
      import) cmd_kubeconfig_import "${3:-}" "${4:-}" ;;
      list) cmd_kubeconfig_list ;;
      remove) cmd_kubeconfig_remove "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  router)
    case "${2:-}" in
      list) cmd_router_list ;;
      provision) cmd_router_provision "${3:-${HERMES_ROUTER_PROVIDER:-nine-router}}" ;;
      cleanup-keys) cmd_router_cleanup_keys "${3:-all}" ;;
      probe) cmd_router_probe ;;
      set) cmd_router_set "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *) usage; [[ -n "${1:-}" ]] && exit 2 || true ;;
esac
