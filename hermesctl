managed_key_stale_ids() {
  # Args: provider current_key managed_name key-list-json
  # Prints stale IDs only. Never prints raw key material.
  python3 - "$@" <<'PYCLEAN'
import json, sys

provider, current, managed, path = sys.argv[1:5]
data = json.load(open(path))
keys = data.get("keys", data if isinstance(data, list) else [])
if not isinstance(keys, list):
    raise SystemExit(3)

same = [k for k in keys if isinstance(k, dict) and k.get("name") == managed]
if len(same) <= 1:
    raise SystemExit(0)

def matches_current(k):
    raw = k.get("key")
    if not isinstance(raw, str):
        return False
    if provider == "nine-router":
        return raw == current
    # OmniRoute deliberately masks keys in management responses:
    # first 8 chars + **** + last 4 chars.
    return len(current) >= 12 and raw.startswith(current[:8]) and raw.endswith(current[-4:])

keepers = [k for k in same if matches_current(k)]
if len(keepers) != 1:
    # Safety first: if the active key cannot be identified unambiguously, do
    # not delete anything.
    raise SystemExit(4)

keep_id = str(keepers[0].get("id", ""))
if not keep_id:
    raise SystemExit(5)

for k in same:
    kid = str(k.get("id", ""))
    if kid and kid != keep_id:
        print(kid)
PYCLEAN
}

cleanup_nine_router_duplicate_keys() {
  need curl; need python3
  load_env
  [[ -n "${NINE_ROUTER_UPSTREAM_API_KEY:-}" ]] || {
    echo "[ok] no managed 9router key configured; nothing to clean"
    return 0
  }
  wait_nine_router 75 || fail "9router did not become ready for duplicate-key cleanup"
  nine_router_key_valid "${NINE_ROUTER_UPSTREAM_API_KEY}" \
    || fail "current 9router managed key is not valid; refusing duplicate cleanup"

  local tmpdir cookie login_json keys_json code base name stale_file
  tmpdir="$(mktemp -d)"; chmod 700 "$tmpdir"
  cookie="$tmpdir/cookies"; login_json="$tmpdir/login.json"
  keys_json="$tmpdir/keys.json"; stale_file="$tmpdir/stale"
  base="$(nine_router_host_url)"
  name="${NINEROUTER_MANAGED_API_KEY_NAME:-hermes-control-plane-router-gateway}"

  code="$(
    python3 - "${NINEROUTER_INITIAL_PASSWORD}" <<'PYLOGIN' |
import json, sys
print(json.dumps({"password": sys.argv[1]}))
PYLOGIN
    curl -sS -c "$cookie" -o "$login_json" -w '%{http_code}' \
      -H 'Content-Type: application/json' --data-binary @- \
      "${base}/api/auth/login" || true
  )"
  if [[ "$code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "9router management login failed; duplicate cleanup aborted without deleting keys"
  fi

  code="$(curl -sS -b "$cookie" -o "$keys_json" -w '%{http_code}' \
    "${base}/api/keys" || true)"
  if [[ "$code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "9router key listing failed with HTTP ${code:-unreachable}"
  fi

  if managed_key_stale_ids nine-router "${NINE_ROUTER_UPSTREAM_API_KEY}" "$name" "$keys_json" >"$stale_file"; then
    :
  else
    rc=$?
    rm -rf "$tmpdir"
    if [[ "$rc" == "4" ]]; then
      fail "could not identify the current 9router key unambiguously; no duplicate keys were deleted"
    fi
    fail "could not reconcile 9router managed keys; no keys were deleted"
  fi

  local count=0 id delcode
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    delcode="$(curl -sS -b "$cookie" -o /dev/null -w '%{http_code}' \
      -X DELETE "${base}/api/keys/${id}" || true)"
    if [[ "$delcode" == "200" ]]; then
      count=$((count+1))
    else
      rm -rf "$tmpdir"
      fail "9router duplicate-key deletion failed with HTTP ${delcode:-unreachable}"
    fi
  done <"$stale_file"
  rm -rf "$tmpdir"
  echo "[ok] 9router managed-key reconciliation complete; removed ${count} stale duplicate(s)"
}

