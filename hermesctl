#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$ROOT/.env"
COMPOSE=(docker compose --project-directory "$ROOT" --env-file "$ENV_FILE")

fail() { echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need() { command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"; }

randhex() {
  openssl rand -hex "${1:-32}"
}

set_env() {
  local key="$1" value="$2"
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); key=sys.argv[2]; value=sys.argv[3]
lines=p.read_text().splitlines() if p.exists() else []
out=[]; found=False
for line in lines:
    if line.startswith(key+'='):
        out.append(f'{key}={value}'); found=True
    else:
        out.append(line)
if not found:
    out.append(f'{key}={value}')
p.write_text('\n'.join(out)+'\n')
PY
}

load_env() {
  [[ -f "$ENV_FILE" ]] || fail ".env does not exist; run ./hermesctl init"
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

init_env() {
  need openssl
  need python3
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ROOT/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "created .env"
  fi
  load_env
  declare -A sizes=(
    [HERMES_CONTROL_ADMIN_TOKEN]=32
    [ROUTER_GATEWAY_ADMIN_TOKEN]=32
    [SMART_ROUTER_HMAC_SECRET]=32
    [SMART_ROUTER_CLIENT_API_KEY]=32
    [SMART_ROUTER_ADMIN_API_KEY]=32
    [SMART_ROUTER_BOOTSTRAP_ADMIN_PASSWORD]=18
    [NINEROUTER_INITIAL_PASSWORD]=18
    [NINEROUTER_JWT_SECRET]=32
    [NINEROUTER_API_KEY_SECRET]=32
    [NINEROUTER_MACHINE_ID_SALT]=32
    [OMNIROUTE_INITIAL_PASSWORD]=18
    [OMNIROUTE_JWT_SECRET]=32
    [OMNIROUTE_API_KEY_SECRET]=32
    [OMNIROUTE_MANAGEMENT_API_KEY]=32
    [OMNIROUTE_STORAGE_ENCRYPTION_KEY]=32
    [OMNIROUTE_MACHINE_ID_SALT]=32
    [OMNIROUTE_WS_BRIDGE_SECRET]=32
  )
  local key current
  for key in "${!sizes[@]}"; do
    current="${!key:-}"
    if [[ -z "$current" || "$current" == "CHANGE_ME" ]]; then
      set_env "$key" "$(randhex "${sizes[$key]}")"
    fi
  done
  info "generated missing local secrets"
  echo "Review $ENV_FILE before exposing services."
}

profiles_for_up() {
  local provider="$1"
  local profiles=("hermes")
  if [[ "${HERMES_ENABLE_BOTH_ROUTERS:-false}" == "true" ]]; then
    profiles+=("nine-router" "omniroute")
  else
    profiles+=("$provider")
  fi
  printf '%s\n' "${profiles[@]}"
}

cmd_up() {
  need docker
  load_env
  local provider="${HERMES_ROUTER_PROVIDER:-nine-router}"
  [[ "$provider" == "nine-router" || "$provider" == "omniroute" ]] || fail "HERMES_ROUTER_PROVIDER must be nine-router or omniroute"
  local args=()
  while IFS= read -r p; do args+=(--profile "$p"); done < <(profiles_for_up "$provider")
  info "starting Hermes Control Plane with active router: $provider"
  "${COMPOSE[@]}" "${args[@]}" up -d --build
  # Persist the active provider through the gateway once it is reachable.
  for _ in $(seq 1 30); do
    if curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" >/dev/null 2>&1; then
      curl -fsS -X PUT \
        -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
        -H 'Content-Type: application/json' \
        -d "{\"provider\":\"$provider\"}" \
        "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/router" >/dev/null
      break
    fi
    sleep 1
  done
  "${COMPOSE[@]}" ps
}

cmd_down() {
  need docker
  load_env
  "${COMPOSE[@]}" --profile nine-router --profile omniroute --profile hermes --profile node-agent down
}

cmd_status() {
  need docker
  load_env
  "${COMPOSE[@]}" --profile nine-router --profile omniroute --profile hermes --profile node-agent ps
  echo
  curl -fsS "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/health" 2>/dev/null || true
  echo
  curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" 2>/dev/null || true
  echo
}

cmd_router_list() {
  need curl
  load_env
  curl -fsS \
    -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
    "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/providers" | python3 -m json.tool
}

cmd_router_set() {
  need docker; need curl
  local provider="${1:-}"
  [[ "$provider" == "nine-router" || "$provider" == "omniroute" ]] || fail "usage: ./hermesctl router set nine-router|omniroute"
  load_env
  local old="${HERMES_ROUTER_PROVIDER:-nine-router}"
  set_env HERMES_ROUTER_PROVIDER "$provider"
  load_env
  info "starting provider $provider"
  "${COMPOSE[@]}" --profile "$provider" up -d "$provider" router-gateway
  for _ in $(seq 1 45); do
    if curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" >/dev/null 2>&1; then break; fi
    sleep 1
  done
  curl -fsS -X PUT \
    -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
    -H 'Content-Type: application/json' \
    -d "{\"provider\":\"$provider\"}" \
    "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/router" | python3 -m json.tool
  if [[ "${HERMES_ENABLE_BOTH_ROUTERS:-false}" != "true" && "$old" != "$provider" ]]; then
    "${COMPOSE[@]}" --profile "$old" stop "$old" >/dev/null 2>&1 || true
  fi
}

cmd_doctor() {
  need python3
  echo "Hermes Control Plane doctor"
  echo "Version: $(cat "$ROOT/VERSION")"
  for c in docker curl openssl python3; do
    if command -v "$c" >/dev/null 2>&1; then echo "[ok] $c"; else echo "[missing] $c"; fi
  done
  if command -v docker >/dev/null 2>&1 && [[ -f "$ENV_FILE" ]]; then
    if "${COMPOSE[@]}" config >/dev/null; then echo "[ok] docker compose config"; else echo "[fail] docker compose config"; fi
  fi
}

usage() {
  cat <<'TXT'
Usage: ./hermesctl <command>

Commands:
  init                         Create .env and generate missing local secrets
  up                           Build/start core + Hermes + selected router
  down                         Stop the stack
  status                       Show Compose and service health
  doctor                       Check local prerequisites/config
  router list                  Show configured router health and active provider
  router set nine-router       Start/select 9router
  router set omniroute         Start/select OmniRoute
TXT
}

case "${1:-}" in
  init) init_env ;;
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  router)
    case "${2:-}" in
      list) cmd_router_list ;;
      set) cmd_router_set "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *) usage; [[ -n "${1:-}" ]] && exit 2 || true ;;
esac
