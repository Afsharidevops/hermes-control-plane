#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_VERSION_OVERRIDE="${VERSION-}"
SHELL_NAMESPACE_OVERRIDE="${IMAGE_NAMESPACE-}"
ENV_FILE="$ROOT/.env"
COMPOSE=(docker compose --project-directory "$ROOT" --env-file "$ENV_FILE")

fail() { echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need() { command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"; }

randhex() {
  openssl rand -hex "${1:-32}"
}

set_env() {
  local key="$1" value="$2"
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); key=sys.argv[2]; value=sys.argv[3]
lines=p.read_text().splitlines() if p.exists() else []
out=[]; found=False
for line in lines:
    if line.startswith(key+'='):
        out.append(f'{key}={value}'); found=True
    else:
        out.append(line)
if not found:
    out.append(f'{key}={value}')
p.write_text('\n'.join(out)+'\n')
PY
}

load_env() {
  [[ -f "$ENV_FILE" ]] || fail ".env does not exist; run ./hermesctl init"
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

init_env() {
  need openssl
  need python3
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ROOT/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "created .env"
  fi
  load_env
  declare -A sizes=(
    [HERMES_CONTROL_ADMIN_TOKEN]=32
    [HERMES_BOT_SERVICE_TOKEN]=32
    [HERMES_APPROVAL_BOT_TOKEN]=32
    [HERMES_KUBERNETES_BROKER_TOKEN]=32
    [HERMES_EXECUTION_HMAC_KEY]=32
    [ROUTER_GATEWAY_ADMIN_TOKEN]=32
    [SMART_ROUTER_HMAC_SECRET]=32
    [SMART_ROUTER_CLIENT_API_KEY]=32
    [SMART_ROUTER_ADMIN_API_KEY]=32
    [SMART_ROUTER_BOOTSTRAP_ADMIN_PASSWORD]=18
    [NINEROUTER_INITIAL_PASSWORD]=18
    [NINEROUTER_JWT_SECRET]=32
    [NINEROUTER_API_KEY_SECRET]=32
    [NINEROUTER_MACHINE_ID_SALT]=32
    [OMNIROUTE_INITIAL_PASSWORD]=18
    [OMNIROUTE_JWT_SECRET]=32
    [OMNIROUTE_API_KEY_SECRET]=32
    [OMNIROUTE_MANAGEMENT_API_KEY]=32
    [OMNIROUTE_STORAGE_ENCRYPTION_KEY]=32
    [OMNIROUTE_MACHINE_ID_SALT]=32
    [OMNIROUTE_WS_BRIDGE_SECRET]=32
  )
  local key current
  for key in "${!sizes[@]}"; do
    current="${!key:-}"
    if [[ -z "$current" || "$current" == "CHANGE_ME" ]]; then
      set_env "$key" "$(randhex "${sizes[$key]}")"
    fi
  done

  # Keep imported kubeconfigs mode 0600. For local Docker/Compose, the broker
  # must use the host operator's numeric UID/GID to read the bind-mounted files.
  if [[ -z "${HERMES_KUBERNETES_BROKER_UID:-}" ]]; then
    set_env HERMES_KUBERNETES_BROKER_UID "$(id -u)"
  fi
  if [[ -z "${HERMES_KUBERNETES_BROKER_GID:-}" ]]; then
    set_env HERMES_KUBERNETES_BROKER_GID "$(id -g)"
  fi

  # Any identity trusted to request Control Plane mutations must also be able
  # to reach the upstream Hermes Telegram gateway. Preserve any other Telegram
  # users while adding the Control Plane mutation allowlist.
  local telegram_users
  telegram_users="$(python3 - "${TELEGRAM_ALLOWED_USERS:-}" "${HERMES_CONTROL_PLANE_BOT_USERS:-}" <<'PYTG'
import sys
out=[]
for raw in sys.argv[1:]:
    for item in raw.replace(',', '\n').splitlines():
        item=item.strip()
        if item and item.isdigit() and item not in out:
            out.append(item)
print(','.join(out))
PYTG
)"
  if [[ -n "$telegram_users" ]]; then
    set_env TELEGRAM_ALLOWED_USERS "$telegram_users"
  fi

  info "generated missing local secrets"
  echo "Review $ENV_FILE before exposing services."
}

profiles_for_up() {
  local provider="$1"
  local profiles=("hermes")
  if [[ "${HERMES_ENABLE_BOTH_ROUTERS:-false}" == "true" ]]; then
    profiles+=("nine-router" "omniroute")
  else
    profiles+=("$provider")
  fi
  printf '%s\n' "${profiles[@]}"
}

hermes_cli_run() {
  # Run the Hermes CLI without the image's s6/gateway entrypoint. This is
  # critical for Telegram: a normal `docker compose run hermes ...` starts a
  # second gateway and creates a competing getUpdates poller.
  "${COMPOSE[@]}" --profile hermes run --rm --no-deps -T \
    --entrypoint /opt/hermes/.venv/bin/hermes \
    -e TELEGRAM_BOT_TOKEN= \
    -e TELEGRAM_ALLOWED_USERS= \
    hermes "$@"
}

hermes_python_run() {
  "${COMPOSE[@]}" --profile hermes run --rm --no-deps -T \
    --entrypoint /opt/hermes/.venv/bin/python \
    -e TELEGRAM_BOT_TOKEN= \
    -e TELEGRAM_ALLOWED_USERS= \
    hermes "$@"
}

ensure_hermes_router_model() {
  need docker
  load_env
  info "synchronizing Hermes model endpoint with internal Smart Router"
  hermes_python_run - <<'PYMODEL'
from pathlib import Path
import os, shutil, time, yaml
path=Path('/opt/data/config.yaml')
data={}
if path.exists():
    loaded=yaml.safe_load(path.read_text())
    if isinstance(loaded,dict): data=loaded
old=data.get('model')
model=dict(old) if isinstance(old,dict) else {}
desired={
    'provider':'custom',
    'default':os.environ.get('HERMES_MODEL','auto') or 'auto',
    'base_url':'http://smart-router:8080/v1',
    'api_mode':'chat_completions',
    # Keep the actual Smart Router client secret in the process environment.
    # Hermes expands this reference at runtime; config.yaml never receives the
    # raw key material.
    'api_key':'${OPENAI_API_KEY}',
}
changed=False
for k,v in desired.items():
    if model.get(k)!=v:
        model[k]=v; changed=True
if data.get('model')!=model:
    data['model']=model; changed=True
if changed:
    if path.exists():
        shutil.copy2(path,path.with_name(f'config.yaml.pre-hcp-model-{int(time.time())}.bak'))
    path.write_text(yaml.safe_dump(data,sort_keys=False))
    print('Hermes model configuration updated: Smart Router + model=auto')
else:
    print('Hermes model configuration already synchronized.')
PYMODEL
}

ensure_chatops_plugin() {
  need docker
  load_env
  info "ensuring Hermes Control Plane ChatOps plugin is enabled"
  # The plugin lives in persistent /opt/data/plugins and is opt-in. Use the
  # CLI-only entrypoint so enabling it never launches a transient gateway.
  if ! hermes_cli_run plugins enable control-plane-chatops >/dev/null; then
    fail "could not enable control-plane-chatops plugin; run ./hermesctl bot check"
  fi
}

omniroute_host_url() {
  printf 'http://%s:%s' "${OMNIROUTE_PROVISION_HOST:-127.0.0.1}" "${OMNIROUTE_PORT:-20228}"
}

omniroute_api_host_url() {
  printf 'http://%s:%s' "${OMNIROUTE_PROVISION_HOST:-127.0.0.1}" "${OMNIROUTE_API_PORT:-20229}"
}

wait_omniroute() {
  need curl
  local timeout="${1:-75}" elapsed=0 base
  base="$(omniroute_host_url)"
  while (( elapsed < timeout )); do
    if curl -fsS "${base}/api/monitoring/health" >/dev/null 2>&1 \
       || curl -fsS "${base}/api/init" >/dev/null 2>&1 \
       || curl -fsS "${base}/" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    elapsed=$((elapsed+1))
  done
  return 1
}

omniroute_key_http_status() {
  need curl
  local key="${1:-}" base code
  [[ -n "$key" ]] || { printf '000'; return 0; }
  base="$(omniroute_api_host_url)"
  code="$(curl -sS --compressed -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer ${key}" \
    "${base}/v1/models" 2>/dev/null || true)"
  printf '%s' "${code:-000}"
}

omniroute_key_valid() {
  [[ "$(omniroute_key_http_status "${1:-}")" == "200" ]]
}

ensure_omniroute_api_key() {
  need curl
  need python3
  load_env

  if [[ "${OMNIROUTE_AUTO_PROVISION_API_KEY:-true}" != "true" ]]; then
    [[ -n "${OMNIROUTE_UPSTREAM_API_KEY:-}" ]] \
      || fail "OmniRoute automatic API-key provisioning is disabled and OMNIROUTE_UPSTREAM_API_KEY is empty"
    omniroute_key_valid "${OMNIROUTE_UPSTREAM_API_KEY}" \
      || fail "configured OmniRoute Router Gateway API key is not accepted"
    echo "[ok] OmniRoute Router Gateway API key is configured"
    return 0
  fi

  # If we already hold a managed key, wait for OmniRoute to be ready BEFORE
  # deciding whether it is valid. A stopped/starting provider must never look
  # like an authentication failure and trigger credential rotation.
  if [[ -n "${OMNIROUTE_UPSTREAM_API_KEY:-}" ]]; then
    if ! wait_omniroute 90; then
      fail "OmniRoute did not become ready; refusing to rotate the existing managed API key"
    fi
    local existing_status
    existing_status="$(omniroute_key_http_status "${OMNIROUTE_UPSTREAM_API_KEY}")"
    if [[ "$existing_status" == "200" ]]; then
      echo "[ok] managed OmniRoute API key is already valid"
      return 0
    fi
    if [[ "$existing_status" != "401" && "$existing_status" != "403" ]]; then
      fail "OmniRoute key validation returned HTTP ${existing_status}; refusing credential rotation on a transient/non-authentication error"
    fi
    info "existing OmniRoute managed key was explicitly rejected (${existing_status}); rotating it"
  else
    if ! wait_omniroute 90; then
      fail "OmniRoute did not become reachable for API-key provisioning"
    fi
  fi

  info "provisioning dedicated OmniRoute API key for Router Gateway"

  [[ -n "${OMNIROUTE_INITIAL_PASSWORD:-}" ]] \
    || fail "OMNIROUTE_INITIAL_PASSWORD is missing; cannot authenticate to OmniRoute management API"

  local tmpdir cookie login_json key_json login_code key_code managed_name provisioned_key base
  tmpdir="$(mktemp -d)"
  chmod 700 "$tmpdir"
  cookie="$tmpdir/cookies"
  login_json="$tmpdir/login.json"
  key_json="$tmpdir/key.json"
  managed_name="${OMNIROUTE_MANAGED_API_KEY_NAME:-hermes-control-plane-router-gateway}"
  base="$(omniroute_host_url)"

  # One login attempt only. OmniRoute has brute-force lockout protection.
  login_code="$(
    python3 - "${OMNIROUTE_INITIAL_PASSWORD}" <<'PYLOGIN' |
import json, sys
print(json.dumps({"password": sys.argv[1]}))
PYLOGIN
    curl -sS \
      -c "$cookie" \
      -o "$login_json" \
      -w '%{http_code}' \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${base}/api/auth/login" || true
  )"

  if [[ "$login_code" != "200" ]]; then
    rm -rf "$tmpdir"
    fail "OmniRoute management login failed with HTTP ${login_code:-unreachable}; provisioning stops after one attempt to avoid lockout"
  fi

  # Server-to-server call deliberately sends no Origin header. OmniRoute's
  # management mutation origin guard permits this path while cookie auth still
  # authenticates the request.
  key_code="$(
    python3 - "$managed_name" <<'PYKEY' |
import json, sys
# 'chat' is a non-management runtime scope. OmniRoute also adds its own
# self-service usage scope during key creation.
print(json.dumps({"name": sys.argv[1], "scopes": ["chat"]}))
PYKEY
    curl -sS \
      -b "$cookie" \
      -o "$key_json" \
      -w '%{http_code}' \
      -H 'Content-Type: application/json' \
      --data-binary @- \
      "${base}/api/keys" || true
  )"

  if [[ "$key_code" != "201" ]]; then
    rm -rf "$tmpdir"
    fail "OmniRoute API-key creation failed with HTTP ${key_code:-unreachable}"
  fi

  provisioned_key="$(
    python3 - "$key_json" <<'PYREAD'
import json, sys
data=json.load(open(sys.argv[1]))
key=data.get("key")
if not isinstance(key, str) or len(key.strip()) < 16 or any(ch.isspace() for ch in key):
    raise SystemExit(2)
print(key.strip())
PYREAD
  )" || {
    rm -rf "$tmpdir"
    fail "OmniRoute API-key creation returned an invalid response"
  }

  rm -rf "$tmpdir"

  set_env OMNIROUTE_UPSTREAM_API_KEY "$provisioned_key"
  chmod 600 "$ENV_FILE"
  load_env

  if ! omniroute_key_valid "${OMNIROUTE_UPSTREAM_API_KEY}"; then
    fail "OmniRoute created a managed Router Gateway key but rejected it during /v1/models verification"
  fi

  echo "[ok] provisioned and verified dedicated OmniRoute Router Gateway API key"
  echo "     key material stored only in local .env"
}

