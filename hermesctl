cmd_up() {
  need docker
  load_env
  local mode="${1:-}"
  local provider="${HERMES_ROUTER_PROVIDER:-nine-router}"
  [[ "$provider" == "nine-router" || "$provider" == "omniroute" ]] || fail "HERMES_ROUTER_PROVIDER must be nine-router or omniroute"
  local args=()
  while IFS= read -r p; do args+=(--profile "$p"); done < <(profiles_for_up "$provider")
  if [[ "$mode" == "--pull" ]]; then
    info "pulling published images for Hermes Control Plane ($provider)"
    "${COMPOSE[@]}" "${args[@]}" pull
    bootstrap_selected_router
    ensure_hermes_router_model
    ensure_chatops_plugin
    "${COMPOSE[@]}" "${args[@]}" up -d --no-build
  elif [[ -z "$mode" ]]; then
    bootstrap_selected_router
    ensure_hermes_router_model
    ensure_chatops_plugin
    info "starting Hermes Control Plane with active router: $provider"
    "${COMPOSE[@]}" "${args[@]}" up -d --build
  else
    fail "usage: ./hermesctl up [--pull]"
  fi
  # Persist the active provider through the gateway once it is reachable.
  for _ in $(seq 1 30); do
    if curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" >/dev/null 2>&1; then
      curl -fsS -X PUT \
        -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
        -H 'Content-Type: application/json' \
        -d "{\"provider\":\"$provider\"}" \
        "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/router" >/dev/null
      break
    fi
    sleep 1
  done
  cmd_wait 90
  "${COMPOSE[@]}" ps
}

cmd_wait() {
  need curl
  load_env
  local timeout="${1:-60}" elapsed=0
  info "waiting for Control Plane and Kubernetes Broker health"
  while (( elapsed < timeout )); do
    if curl -fsS "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/health" >/dev/null 2>&1 \
       && curl -fsS "http://${KUBERNETES_BROKER_BIND_IP:-127.0.0.1}:${KUBERNETES_BROKER_PORT:-8830}/health" >/dev/null 2>&1; then
      echo "Control Plane and Kubernetes Broker are ready."
      return 0
    fi
    sleep 1
    elapsed=$((elapsed+1))
  done
  fail "services did not become healthy within ${timeout}s"
}

