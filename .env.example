# Hermes Control Plane 0.5.10-alpha.2
# Copy to .env, then run ./hermesctl init. Never commit .env.

# Project-owned images. Set this to your Docker Hub username/organization after publishing.
IMAGE_NAMESPACE=afsharidevops
VERSION=0.5.10-alpha.2

# Runtime router selection: nine-router | omniroute
HERMES_ROUTER_PROVIDER=nine-router
HERMES_ENABLE_BOTH_ROUTERS=false

# Project endpoints (loopback by default)
CONTROL_PLANE_BIND_IP=127.0.0.1
CONTROL_PLANE_PORT=8800
ROUTER_GATEWAY_BIND_IP=127.0.0.1
ROUTER_GATEWAY_PORT=8790
SMART_ROUTER_BIND_IP=127.0.0.1
SMART_ROUTER_PORT=8787
HERMES_BIND_IP=127.0.0.1
HERMES_API_PORT=8642
HERMES_DASHBOARD_PORT=9119

# Generated by ./hermesctl init
HERMES_CONTROL_ADMIN_TOKEN=CHANGE_ME
ROUTER_GATEWAY_ADMIN_TOKEN=CHANGE_ME
SMART_ROUTER_HMAC_SECRET=CHANGE_ME
SMART_ROUTER_CLIENT_API_KEY=CHANGE_ME
SMART_ROUTER_ADMIN_API_KEY=CHANGE_ME
SMART_ROUTER_BOOTSTRAP_ADMIN_USER=admin
SMART_ROUTER_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Smart Router behavior. Neutral aliases are translated by router-gateway.
SMART_ROUTER_MODE=observe
SMART_ROUTER_POLICY=heuristic
SMART_ROUTER_OBSERVE_MODEL=hermes/observe
SMART_ROUTER_FAST_MODEL=hermes/fast
SMART_ROUTER_STANDARD_MODEL=hermes/standard
SMART_ROUTER_STRONG_MODEL=hermes/strong
SMART_ROUTER_CODING_MODEL=hermes/coding
SMART_ROUTER_VISION_MODEL=hermes/vision

# 9router upstream image and bootstrap configuration
NINEROUTER_IMAGE_REPOSITORY=decolua/9router
NINEROUTER_IMAGE_TAG=latest
NINEROUTER_BIND_IP=127.0.0.1
NINEROUTER_PORT=20128
NINEROUTER_INITIAL_PASSWORD=CHANGE_ME
NINEROUTER_JWT_SECRET=CHANGE_ME
NINEROUTER_API_KEY_SECRET=CHANGE_ME
NINEROUTER_MACHINE_ID_SALT=CHANGE_ME
NINEROUTER_REQUIRE_API_KEY=false
NINEROUTER_AUTH_COOKIE_SECURE=false
NINEROUTER_PUBLIC_BASE_URL=http://localhost:20128
NINE_ROUTER_UPSTREAM_API_KEY=

# OmniRoute upstream image and bootstrap configuration
OMNIROUTE_IMAGE_REPOSITORY=diegosouzapw/omniroute
OMNIROUTE_IMAGE_TAG=latest
OMNIROUTE_BIND_IP=127.0.0.1
OMNIROUTE_PORT=20228
OMNIROUTE_API_BIND_IP=127.0.0.1
OMNIROUTE_API_PORT=20229
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME
OMNIROUTE_JWT_SECRET=CHANGE_ME
OMNIROUTE_API_KEY_SECRET=CHANGE_ME
OMNIROUTE_MANAGEMENT_API_KEY=CHANGE_ME
OMNIROUTE_STORAGE_ENCRYPTION_KEY=CHANGE_ME
OMNIROUTE_STORAGE_ENCRYPTION_KEY_VERSION=v1
OMNIROUTE_MACHINE_ID_SALT=CHANGE_ME
OMNIROUTE_WS_BRIDGE_SECRET=CHANGE_ME
OMNIROUTE_REQUIRE_API_KEY=false
OMNIROUTE_AUTH_COOKIE_SECURE=false
OMNIROUTE_PUBLIC_BASE_URL=http://localhost:20228
OMNIROUTE_ALLOW_API_KEY_REVEAL=false
OMNIROUTE_MEMORY_MB=512
OMNIROUTE_UPSTREAM_API_KEY=

# Hermes upstream agent (optional profile, enabled by hermesctl by default)
HERMES_IMAGE_REPOSITORY=nousresearch/hermes-agent
HERMES_IMAGE_TAG=latest
HERMES_DASHBOARD=0
HERMES_UID=10000
HERMES_GID=10000

# Future execution services are intentionally disabled in this alpha foundation.
EXECUTION_FEATURES=

# Control Plane integration health probe timeout
HERMES_HEALTH_TIMEOUT_SECONDS=5
