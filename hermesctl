#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SHELL_VERSION_OVERRIDE="${VERSION-}"
SHELL_NAMESPACE_OVERRIDE="${IMAGE_NAMESPACE-}"
ENV_FILE="$ROOT/.env"
COMPOSE=(docker compose --project-directory "$ROOT" --env-file "$ENV_FILE")

fail() { echo "ERROR: $*" >&2; exit 1; }
info() { echo "==> $*"; }
need() { command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"; }

randhex() {
  openssl rand -hex "${1:-32}"
}

set_env() {
  local key="$1" value="$2"
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
from pathlib import Path
import sys
p=Path(sys.argv[1]); key=sys.argv[2]; value=sys.argv[3]
lines=p.read_text().splitlines() if p.exists() else []
out=[]; found=False
for line in lines:
    if line.startswith(key+'='):
        out.append(f'{key}={value}'); found=True
    else:
        out.append(line)
if not found:
    out.append(f'{key}={value}')
p.write_text('\n'.join(out)+'\n')
PY
}

load_env() {
  [[ -f "$ENV_FILE" ]] || fail ".env does not exist; run ./hermesctl init"
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
}

init_env() {
  need openssl
  need python3
  if [[ ! -f "$ENV_FILE" ]]; then
    cp "$ROOT/.env.example" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    info "created .env"
  fi
  load_env
  declare -A sizes=(
    [HERMES_CONTROL_ADMIN_TOKEN]=32
    [HERMES_BOT_SERVICE_TOKEN]=32
    [HERMES_APPROVAL_BOT_TOKEN]=32
    [HERMES_KUBERNETES_BROKER_TOKEN]=32
    [HERMES_EXECUTION_HMAC_KEY]=32
    [ROUTER_GATEWAY_ADMIN_TOKEN]=32
    [SMART_ROUTER_HMAC_SECRET]=32
    [SMART_ROUTER_CLIENT_API_KEY]=32
    [SMART_ROUTER_ADMIN_API_KEY]=32
    [SMART_ROUTER_BOOTSTRAP_ADMIN_PASSWORD]=18
    [NINEROUTER_INITIAL_PASSWORD]=18
    [NINEROUTER_JWT_SECRET]=32
    [NINEROUTER_API_KEY_SECRET]=32
    [NINEROUTER_MACHINE_ID_SALT]=32
    [OMNIROUTE_INITIAL_PASSWORD]=18
    [OMNIROUTE_JWT_SECRET]=32
    [OMNIROUTE_API_KEY_SECRET]=32
    [OMNIROUTE_MANAGEMENT_API_KEY]=32
    [OMNIROUTE_STORAGE_ENCRYPTION_KEY]=32
    [OMNIROUTE_MACHINE_ID_SALT]=32
    [OMNIROUTE_WS_BRIDGE_SECRET]=32
  )
  local key current
  for key in "${!sizes[@]}"; do
    current="${!key:-}"
    if [[ -z "$current" || "$current" == "CHANGE_ME" ]]; then
      set_env "$key" "$(randhex "${sizes[$key]}")"
    fi
  done
  info "generated missing local secrets"
  echo "Review $ENV_FILE before exposing services."
}

profiles_for_up() {
  local provider="$1"
  local profiles=("hermes")
  if [[ "${HERMES_ENABLE_BOTH_ROUTERS:-false}" == "true" ]]; then
    profiles+=("nine-router" "omniroute")
  else
    profiles+=("$provider")
  fi
  printf '%s\n' "${profiles[@]}"
}

cmd_up() {
  need docker
  load_env
  local mode="${1:-}"
  local provider="${HERMES_ROUTER_PROVIDER:-nine-router}"
  [[ "$provider" == "nine-router" || "$provider" == "omniroute" ]] || fail "HERMES_ROUTER_PROVIDER must be nine-router or omniroute"
  local args=()
  while IFS= read -r p; do args+=(--profile "$p"); done < <(profiles_for_up "$provider")
  if [[ "$mode" == "--pull" ]]; then
    info "pulling published images for Hermes Control Plane ($provider)"
    "${COMPOSE[@]}" "${args[@]}" pull
    "${COMPOSE[@]}" "${args[@]}" up -d --no-build
  elif [[ -z "$mode" ]]; then
    info "starting Hermes Control Plane with active router: $provider"
    "${COMPOSE[@]}" "${args[@]}" up -d --build
  else
    fail "usage: ./hermesctl up [--pull]"
  fi
  # Persist the active provider through the gateway once it is reachable.
  for _ in $(seq 1 30); do
    if curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" >/dev/null 2>&1; then
      curl -fsS -X PUT \
        -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
        -H 'Content-Type: application/json' \
        -d "{\"provider\":\"$provider\"}" \
        "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/router" >/dev/null
      break
    fi
    sleep 1
  done
  cmd_wait 90
  "${COMPOSE[@]}" ps
}

cmd_wait() {
  need curl
  load_env
  local timeout="${1:-60}" elapsed=0
  info "waiting for Control Plane and Kubernetes Broker health"
  while (( elapsed < timeout )); do
    if curl -fsS "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/health" >/dev/null 2>&1 \
       && curl -fsS "http://${KUBERNETES_BROKER_BIND_IP:-127.0.0.1}:${KUBERNETES_BROKER_PORT:-8830}/health" >/dev/null 2>&1; then
      echo "Control Plane and Kubernetes Broker are ready."
      return 0
    fi
    sleep 1
    elapsed=$((elapsed+1))
  done
  fail "services did not become healthy within ${timeout}s"
}

cmd_down() {
  need docker
  load_env
  "${COMPOSE[@]}" --profile nine-router --profile omniroute --profile hermes --profile node-agent down
}

cmd_status() {
  need docker
  load_env
  "${COMPOSE[@]}" --profile nine-router --profile omniroute --profile hermes --profile node-agent ps
  echo
  curl -fsS "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/health" 2>/dev/null || true
  echo
  curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" 2>/dev/null || true
  echo
  curl -fsS "http://${KUBERNETES_BROKER_BIND_IP:-127.0.0.1}:${KUBERNETES_BROKER_PORT:-8830}/health" 2>/dev/null || true
  echo
}

cmd_router_list() {
  need curl
  load_env
  curl -fsS \
    -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
    "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/providers" | python3 -m json.tool
}

cmd_router_set() {
  need docker; need curl
  local provider="${1:-}"
  [[ "$provider" == "nine-router" || "$provider" == "omniroute" ]] || fail "usage: ./hermesctl router set nine-router|omniroute"
  load_env
  local old="${HERMES_ROUTER_PROVIDER:-nine-router}"
  set_env HERMES_ROUTER_PROVIDER "$provider"
  load_env
  info "starting provider $provider"
  "${COMPOSE[@]}" --profile "$provider" up -d "$provider" router-gateway
  for _ in $(seq 1 45); do
    if curl -fsS "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/health" >/dev/null 2>&1; then break; fi
    sleep 1
  done
  curl -fsS -X PUT \
    -H "Authorization: Bearer ${ROUTER_GATEWAY_ADMIN_TOKEN}" \
    -H 'Content-Type: application/json' \
    -d "{\"provider\":\"$provider\"}" \
    "http://${ROUTER_GATEWAY_BIND_IP:-127.0.0.1}:${ROUTER_GATEWAY_PORT:-8790}/management/router" | python3 -m json.tool
  if [[ "${HERMES_ENABLE_BOTH_ROUTERS:-false}" != "true" && "$old" != "$provider" ]]; then
    "${COMPOSE[@]}" --profile "$old" stop "$old" >/dev/null 2>&1 || true
  fi
}


cmd_version() {
  local action="${1:-show}" value="${2:-}"
  [[ -f "$ENV_FILE" ]] || fail ".env does not exist; run ./hermesctl init"
  case "$action" in
    show|"")
      local configured repo running
      configured="$(grep '^VERSION=' "$ENV_FILE" | tail -1 | cut -d= -f2-)"
      repo="$(cat "$ROOT/VERSION")"
      running="$(curl -fsS "http://127.0.0.1:${CONTROL_PLANE_PORT:-8800}/health" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version","unknown"))' 2>/dev/null || true)"
      echo "Repository: ${repo:-unknown}"
      echo "Configured: ${configured:-unknown}"
      echo "Running: ${running:-not-running}"
      ;;
    set)
      [[ "$value" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]] || fail "invalid version: $value"
      set_env VERSION "$value"
      echo "Configured VERSION=$value"
      ;;
    *) fail "usage: ./hermesctl version [set <version>]" ;;
  esac
}

cmd_upgrade() {
  need docker
  local target="${1:-}"
  [[ -n "$target" ]] || fail "usage: ./hermesctl upgrade <version>"
  [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?$ ]] || fail "invalid version: $target"
  load_env
  local old="${VERSION:-}"
  local ns="${IMAGE_NAMESPACE:-afsharidevops}"
  info "verifying published release images for $target"
  docker buildx imagetools inspect "$ns/hermes-control-plane-api:$target" >/dev/null || fail "API image tag not found"
  docker buildx imagetools inspect "$ns/hermes-control-plane-kubernetes-broker:$target" >/dev/null || fail "Kubernetes Broker image tag not found"
  mkdir -p "$ROOT/backups"
  if "${COMPOSE[@]}" ps --status running --services | grep -qx control-plane; then
    local stamp
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    "${COMPOSE[@]}" cp control-plane:/data/control-plane.sqlite3 "$ROOT/backups/control-plane-$stamp.sqlite3" >/dev/null 2>&1 || true
  fi
  set_env VERSION "$target"
  if ! cmd_up --pull; then
    echo "Upgrade failed; restoring configured version $old" >&2
    set_env VERSION "$old"
    cmd_up --pull || true
    return 1
  fi
  info "upgrade complete: $old -> $target"
}

cmd_kubeconfig_import() {
  need curl; need python3; need sha256sum
  local name="${1:-}" file="${2:-}"
  [[ -n "$name" && -f "$file" ]] || fail "usage: ./hermesctl kubeconfig import <name> <file>"
  load_env
  local sha response id dest
  sha="$(sha256sum "$file" | awk '{print $1}')"
  response="$(python3 - "$name" "$sha" <<'PYJSON' | curl -fsS -X POST \
      -H "Authorization: Bearer ${HERMES_CONTROL_ADMIN_TOKEN}" -H 'Content-Type: application/json' \
      --data-binary @- "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs"
import json,sys
print(json.dumps({"name":sys.argv[1],"kind":"kubeconfig","provider":"local-file","metadata":{"storage":"local-kubeconfig","sha256":sys.argv[2]}}))
PYJSON
  )"
  id="$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
  dest="$ROOT/data/kubeconfigs/${id}.yaml"
  install -m 0600 "$file" "$dest"
  python3 - "$sha" "$id" <<'PYJSON' | curl -fsS -X PATCH \
      -H "Authorization: Bearer ${HERMES_CONTROL_ADMIN_TOKEN}" -H 'Content-Type: application/json' \
      --data-binary @- "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs/$id" | python3 -m json.tool
import json,sys
print(json.dumps({"metadata":{"storage":"local-kubeconfig","sha256":sys.argv[1],"file":sys.argv[2]+".yaml"}}))
PYJSON
  echo "Stored kubeconfig material at $dest (mode 0600). The Control Plane stores only its reference/fingerprint."
}

cmd_kubeconfig_list() {
  need curl; need python3
  load_env
  curl -fsS "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs" | python3 -c 'import json,sys; print(json.dumps([x for x in json.load(sys.stdin) if x.get("kind")=="kubeconfig"], indent=2))'
}

cmd_kubeconfig_remove() {
  need curl
  local id="${1:-}"
  [[ "$id" =~ ^cred_[0-9a-f]{16}$ ]] || fail "usage: ./hermesctl kubeconfig remove <credential-id>"
  load_env
  curl -fsS -X DELETE -H "Authorization: Bearer ${HERMES_CONTROL_ADMIN_TOKEN}" "http://${CONTROL_PLANE_BIND_IP:-127.0.0.1}:${CONTROL_PLANE_PORT:-8800}/v1/credential-refs/$id"
  rm -f "$ROOT/data/kubeconfigs/$id.yaml"
  echo "Removed $id"
}

cmd_execution() {
  need docker
  local action="${1:-status}"
  load_env
  case "$action" in
    status)
      echo "HERMES_EXECUTION_ENABLED=${HERMES_EXECUTION_ENABLED:-false}"
      echo "HERMES_KUBERNETES_EXECUTION_ENABLED=${HERMES_KUBERNETES_EXECUTION_ENABLED:-false}"
      ;;
    enable|disable)
      local value=false
      [[ "$action" == "enable" ]] && value=true
      set_env HERMES_EXECUTION_ENABLED "$value"
      set_env HERMES_KUBERNETES_EXECUTION_ENABLED "$value"
      load_env
      info "execution ${action}d; recreating Control Plane and Kubernetes Broker"
      "${COMPOSE[@]}" up -d --force-recreate control-plane kubernetes-broker
      cmd_wait 90
      cmd_execution status
      ;;
    *) fail "usage: ./hermesctl execution enable|disable|status" ;;
  esac
}

cmd_bot() {
  need python3
  local action="${1:-status}" value="${2:-}"
  load_env
  case "$action" in
    status)
      [[ -n "${HERMES_BOT_SERVICE_TOKEN:-}" && "${HERMES_BOT_SERVICE_TOKEN:-}" != "CHANGE_ME" ]] && echo "Hermes Bot service identity: configured" || echo "Hermes Bot service identity: missing"
      [[ -n "${HERMES_APPROVAL_BOT_TOKEN:-}" && "${HERMES_APPROVAL_BOT_TOKEN:-}" != "CHANGE_ME" ]] && echo "Approval Bot service identity: configured" || echo "Approval Bot service identity: missing"
      echo "Telegram mutation users: ${HERMES_CONTROL_PLANE_BOT_USERS:-<none>}"
      ;;
    allow)
      [[ "$value" =~ ^[0-9]+$ ]] || fail "usage: ./hermesctl bot allow <numeric-telegram-user-id>"
      local merged
      merged="$(python3 - "${HERMES_CONTROL_PLANE_BOT_USERS:-}" "$value" <<'PYBOT'
import sys
existing=[x.strip() for x in sys.argv[1].replace(',', '\n').splitlines() if x.strip()]
value=sys.argv[2]
if value not in existing: existing.append(value)
print(','.join(existing))
PYBOT
)"
      set_env HERMES_CONTROL_PLANE_BOT_USERS "$merged"
      echo "Allowed Telegram user $value for Hermes Control Plane mutation requests."
      echo "Recreate Hermes with: docker compose --env-file .env --profile hermes up -d --force-recreate hermes"
      ;;
    *) fail "usage: ./hermesctl bot allow <telegram-user-id>|status" ;;
  esac
}

cmd_doctor() {
  need python3
  echo "Hermes Control Plane doctor"
  echo "Version: $(cat "$ROOT/VERSION")"
  local file_version file_ns
  file_version="$(grep '^VERSION=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  file_ns="$(grep '^IMAGE_NAMESPACE=' "$ENV_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)"
  if [[ -n "$SHELL_VERSION_OVERRIDE" && "$SHELL_VERSION_OVERRIDE" != "$file_version" ]]; then echo "[warn] shell VERSION=$SHELL_VERSION_OVERRIDE differs from .env VERSION=$file_version"; fi
  if [[ -n "$SHELL_NAMESPACE_OVERRIDE" && "$SHELL_NAMESPACE_OVERRIDE" != "$file_ns" ]]; then echo "[warn] shell IMAGE_NAMESPACE=$SHELL_NAMESPACE_OVERRIDE differs from .env IMAGE_NAMESPACE=$file_ns"; fi
  for c in docker curl openssl python3; do
    if command -v "$c" >/dev/null 2>&1; then echo "[ok] $c"; else echo "[missing] $c"; fi
  done
  if command -v docker >/dev/null 2>&1 && [[ -f "$ENV_FILE" ]]; then
    if "${COMPOSE[@]}" config >/dev/null; then echo "[ok] docker compose config"; else echo "[fail] docker compose config"; fi
  fi
}

usage() {
  cat <<'TXT'
Usage: ./hermesctl <command>

Commands:
  init                         Create .env and generate missing local secrets
  up                           Build/start core + Hermes + selected router
  up --pull                    Pull published images and start without local builds
  down                         Stop the stack
  status                       Show Compose and service health
  wait [seconds]               Wait until Control Plane and Kubernetes Broker are ready
  execution enable|disable     Toggle mutation execution and wait for readiness
  execution status             Show execution gates
  bot allow <telegram-id>      Allow a numeric Telegram user to request bot-only mutations
  bot status                   Show bot service identity/allowlist status (never tokens)
  doctor                       Check local prerequisites/config
  router list                  Show configured router health and active provider
  router set nine-router       Start/select 9router
  router set omniroute         Start/select OmniRoute
  version                      Show repository/configured/running versions
  version set <version>        Set .env VERSION explicitly
  upgrade <version>            Verify, backup, pull and upgrade a published release
  kubeconfig import <n> <file> Import kubeconfig material locally and create a reference
  kubeconfig list              List kubeconfig credential references
  kubeconfig remove <id>       Remove unused kubeconfig reference and local material
TXT
}

case "${1:-}" in
  init) init_env ;;
  up) cmd_up "${2:-}" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  wait) cmd_wait "${2:-60}" ;;
  execution) cmd_execution "${2:-status}" ;;
  bot) cmd_bot "${2:-status}" "${3:-}" ;;
  doctor) cmd_doctor ;;
  version) cmd_version "${2:-show}" "${3:-}" ;;
  upgrade) cmd_upgrade "${2:-}" ;;
  kubeconfig)
    case "${2:-}" in
      import) cmd_kubeconfig_import "${3:-}" "${4:-}" ;;
      list) cmd_kubeconfig_list ;;
      remove) cmd_kubeconfig_remove "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  router)
    case "${2:-}" in
      list) cmd_router_list ;;
      set) cmd_router_set "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *) usage; [[ -n "${1:-}" ]] && exit 2 || true ;;
esac
